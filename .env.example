# Public URL of the deployed site (no trailing slash). Used for canonical URLs,
# Open Graph, sitemap and robots. Leave unset until the production domain is confirmed.
NEXT_PUBLIC_SITE_URL=

# Enquiry delivery (server-side only). Enquiries are sent through Resend's HTTP API.
# Without all three values the contact and project-brief forms report that online
# submissions are not yet connected; nothing is silently dropped.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
# Must be an address on a domain verified in Resend, e.g. "WNJO <hello@your-domain>"
ENQUIRY_FROM_EMAIL=

# Customer accounts (follow your order). The publishable key is safe in the browser:
# row-level security limits each signed-in customer to their own orders.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Enquiry storage (server-only SECRET key). Saves every contact and brief to the enquiries table,
# so nothing is lost if email fails. Never prefix with NEXT_PUBLIC_ and never commit the value.
SUPABASE_SERVICE_ROLE_KEY=
